# ---------- API keys (basta uma; modelos sem chave são omitidos) ----------
# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq Cloud — https://console.groq.com/keys
GROQ_API_KEY=

# Mistral La Plateforme — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ---------- servidor ----------
# Precisa bater com o BACKEND_URL do proxy em web/vite.config.ts.
PORT=3030
# DB_PATH=./data.db

# ---------- segurança ----------
# Vazio = API aberta (ok em localhost, nunca em rede). Se definido, toda
# requisição precisa de `Authorization: Bearer <token>`; no frontend, defina
# o mesmo valor como VITE_API_TOKEN em web/.env.
# API_TOKEN=
# Allowlist de origens, separadas por vírgula.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ANY=false
# Rate limit por IP por janela.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# CHAT_RATE_LIMIT_MAX=20
# MAX_PROMPT_CHARS=32000
# MAX_PANEL_SIZE=6

# ---------- timeouts / retry ----------
# Idle reinicia a cada chunk: um stream que está produzindo tokens não é morto.
# MODEL_IDLE_TIMEOUT_MS=60000
# Teto absoluto de uma tentativa.
# MODEL_HARD_TIMEOUT_MS=180000
# MODEL_MAX_RETRIES=2
# Comentário SSE periódico pra proxies não derrubarem a conexão.
# SSE_HEARTBEAT_MS=15000

# ---------- janela de contexto e sumarização ----------
# Quantas mensagens (incluindo a atual) entram em cada chamada.
# HISTORY_WINDOW=6
# Total mínimo de mensagens pra começar a sumarizar o histórico antigo.
# SUMMARIZE_AFTER=10
# E só sumariza se o histórico antigo somar pelo menos esses chars.
# SUMMARIZE_AFTER_CHARS=4000
# Truncate de rascunho enviado para R2/R3 (em chars).
# DRAFT_TRUNCATE_CHARS=4000

# ---------- caps de saída por rodada ----------
# MAX_TOKENS_DRAFT=800
# MAX_TOKENS_DRAFT_CODE=1200
# MAX_TOKENS_REVISION=700
# MAX_TOKENS_SYNTHESIS=1000
# MAX_TOKENS_SUMMARY=200

# ---------- painel adaptativo em contexto de código ----------
# Quando o prompt for de código e o modo for panel_*, reduz o painel.
# ADAPTIVE_PANEL_CODE=true
# ADAPTIVE_PANEL_CODE_SIZE=2

# ---------- thresholds de similaridade (decisões de fluxo) ----------
# SIMILARITY_SKIP_CRITIQUE=0.30
# SIMILARITY_EARLY_EXIT=0.55
# SIMILARITY_DEDUP=0.7

# ---------- paginação ----------
# CONVERSATION_PAGE_SIZE=200
# MESSAGE_PAGE_SIZE=200
